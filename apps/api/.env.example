# ============================================================================
# TrellisFlow API — Environment Variables
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to git.

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Pooled connection (used by the app at runtime).
DATABASE_URL=postgresql://user:password@localhost:5432/trellisflow
# Direct connection (used for migrations).
DIRECT_URL=postgresql://user:password@localhost:5432/trellisflow

# ----------------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ----------------------------------------------------------------------------
# Email (Resend)
# ----------------------------------------------------------------------------
# Get an API key at https://resend.com
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=noreply@trellisflow.com

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001