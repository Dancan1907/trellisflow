# ============================================================================
# TrellisFlow API — Environment Variables
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to git.

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Pooled connection (used by the app at runtime).
DATABASE_URL=postgresql://user:password@localhost:5432/trellisflow
# Direct connection (used for migrations).
DIRECT_URL=postgresql://user:password@localhost:5432/trellisflow

# ----------------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ----------------------------------------------------------------------------
# Email (Resend)
# ----------------------------------------------------------------------------
# Get an API key at https://resend.com
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=noreply@trellisflow.com

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001

# ============================================================================
# AI provider (server-side only)
# ============================================================================
# Gemini is the primary development provider. Create a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite\n# Embedding model used only by the Help Assistant document index and retrieval.\nGEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OpenRouter remains available as an alternative provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Anthropic remains available as an optional provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_REQUEST_TIMEOUT_MS=30000
# Keep disabled until credentials are configured and synthetic evaluation is complete.
AI_MPESA_PARSE_ENABLED=false
# Maximum parse attempts per user per UTC day.
AI_MPESA_DAILY_LIMIT=20
# Optional provider pricing, USD per 1 million tokens. Leave blank for free models
# or until verified against the active provider/model's published pricing.
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=
# Explicit opt-in for the developer-only synthetic live evaluation script.
MPESA_EVAL_ALLOW_PROVIDER_CALLS=false

# ============================================================================
# Auto-Pricing Providers (Wave 5.7)
# ============================================================================
# Alpha Vantage — free tier: 25 req/day, 5 req/min
# Get a key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub — free tier: 60 req/min
# Get a key at https://finnhub.io/register
FINNHUB_API_KEY=

# CoinGecko — free, no key strictly required for public endpoints, but rate-limited
# Providing a demo key raises the rate limit:
#   https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# Optional tuning
PRICE_REFRESH_CRON="*/30 * * * *"
PRICE_MIN_INTERVAL_MS=1800000


AI_NL_DRAFT_ENABLED=true
AI_NL_DRAFT_DAILY_LIMIT=20

# Product Help Assistant (uses approved docs only; separate daily quota).\nAI_HELP_ASSISTANT_ENABLED=false\nAI_HELP_ASSISTANT_DAILY_LIMIT=20\n\n# Read-only Money Copilot (separate quota from M-Pesa and transaction drafts).
# Keep disabled until the server-side provider key and financial-data access are validated.
AI_MONEY_COPILOT_ENABLED=false
AI_MONEY_COPILOT_DAILY_LIMIT=20

# AI narration for deterministic insights (separate per-user daily quota).
# Keep disabled until the narration migration and synthetic tests are complete.
AI_INSIGHTS_NARRATION_ENABLED=false
AI_INSIGHTS_NARRATION_DAILY_LIMIT=20

#INSIGHTS NARRATION

