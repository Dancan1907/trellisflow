# ============================================================================
# TrellisFlow Web — Environment Variables
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to git.

# ----------------------------------------------------------------------------
# API URL (client-side)
# ----------------------------------------------------------------------------
# The URL the browser uses to reach the TrellisFlow API.
NEXT_PUBLIC_API_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# App URL (for redirects and links)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ----------------------------------------------------------------------------
# Environment name
# ----------------------------------------------------------------------------
# development | staging | production
NEXT_PUBLIC_ENVIRONMENT=development
# Show the Money Copilot navigation only when the API feature is enabled.
NEXT_PUBLIC_MONEY_COPILOT_ENABLED=false

#READ ONLY MONEY COPILOT
AI_MONEY_COPILOT_ENABLED=true
AI_MONEY_COPILOT_DAILY_LIMIT=20

NEXT_PUBLIC_MONEY_COPILOT_ENABLED=true	