# ============================================================================
# TrellisFlow — Root Environment Variables
# ============================================================================
# This file documents environment variables used across the monorepo.
#
# Application-specific variables live in:
#   - apps/api/.env.example
#   - apps/web/.env.example
#
# Copy this file to `.env` for local development if you need root-level vars.
# NEVER commit real `.env` files to git.

# ----------------------------------------------------------------------------
# Turborepo
# ----------------------------------------------------------------------------
# Leave empty unless you're using Turborepo Remote Caching.
# TURBO_TOKEN=
# TURBO_TEAM=

# ----------------------------------------------------------------------------
# Development
# ----------------------------------------------------------------------------
# Set to 1 to enable verbose logging across all apps.
VERBOSE=0